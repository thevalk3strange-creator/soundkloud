{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SoundKloud",
  "version": "0.1.0",
  "identifier": "com.gamvoc.soundkloud",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "SoundKloud",
        "width": 1280,
        "height": 840,
        "minWidth": 960,
        "minHeight": 620,
        "center": true,
        "resizable": true,
        "fullscreen": false,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "backgroundColor": "#07070b",
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns"
    ],
    "category": "Music",
    "shortDescription": "SoundCloud desktop player",
    "longDescription": "SoundKloud is a lightweight native macOS shell for SoundCloud. It keeps you signed in, plays through the official web player, and adds a mini player, media keys, a tray menu and a small runtime plugin system.",
    "macOS": {
      "minimumSystemVersion": "11.0",
      "dmg": {
        "appPosition": { "x": 180, "y": 170 },
        "applicationFolderPosition": { "x": 480, "y": 170 },
        "windowSize": { "width": 660, "height": 400 }
      }
    }
  }
}
